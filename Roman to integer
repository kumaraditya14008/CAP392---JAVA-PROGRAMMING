class Solution {
    public int romanToInt(String s) {

        int ans = 0;

        for(int i = 0; i < s.length(); i++) {

            int value = 0;

            char ch = s.charAt(i);

            if(ch == 'I') {
                value = 1;
            }
            else if(ch == 'V') {
                value = 5;
            }
            else if(ch == 'X') {
                value = 10;
            }
            else if(ch == 'L') {
                value = 50;
            }
            else if(ch == 'C') {
                value = 100;
            }
            else if(ch == 'D') {
                value = 500;
            }
            else if(ch == 'M') {
                value = 1000;
            }

            if(i + 1 < s.length()) {

                int next = 0;
                char nextChar = s.charAt(i + 1);

                if(nextChar == 'I') next = 1;
                else if(nextChar == 'V') next = 5;
                else if(nextChar == 'X') next = 10;
                else if(nextChar == 'L') next = 50;
                else if(nextChar == 'C') next = 100;
                else if(nextChar == 'D') next = 500;
                else if(nextChar == 'M') next = 1000;

                if(value < next) {
                    ans = ans - value;
                }
                else {
                    ans = ans + value;
                }
            }
            else {
                ans = ans + value;
            }
        }

        return ans;
    }


}